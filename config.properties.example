# ========================================
# Music Auto Tagger Configuration Template
# ========================================
#
# Instructions:
# 1. Copy this file as config.properties
# 2. Modify the configuration items according to your environment
# 3. Place the config file in the project root directory (same level as pom.xml)
#

# ========================================
# Monitor Directory Configuration
# ========================================

# Set the download directory path to monitor
# Docker environment: Use container path /music
# Windows local: Use absolute path, e.g., D:/MusicTest/Download
monitor.directory=/music

# Set the output directory for processed files
# Docker environment: Use container path /app/tagged_music
# Windows local: Use absolute path, e.g., D:/MusicTest/Music
monitor.outputDirectory=/app/tagged_music

# Scan interval (seconds)
# Recommended: 30-60 seconds, adjust based on download frequency
monitor.scanInterval=30

# ========================================
# MusicBrainz API Configuration
# ========================================

# MusicBrainz API URL (usually no need to modify)
musicbrainz.apiUrl=https://musicbrainz.org/ws/2
musicbrainz.coverArtApiUrl=https://coverartarchive.org

# Prefer the anime-jacket edition cover for anime OP/ED tie-in songs.
# Many J-Pop anime singles have two covers: the anime artwork edition and the
# regular edition with the artist's photo. With this on, all releases in the same
# release group are scanned and the anime edition cover is used when available;
# otherwise it falls back to the default release-group cover.
cover.preferAnimeEdition=false
# Keywords used to detect the anime edition (matched against release title +
# disambiguation, case-insensitive). Earlier keywords have higher weight.
cover.animeEditionKeywords=\u30a2\u30cb\u30e1\u76e4,\u30a2\u30cb\u30e1\u7248,\u30a2\u30cb\u30e1\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8,\u30a2\u30cb\u30e1\u30b8\u30e3\u30b1\u30c3\u30c8,\u30a2\u30cb\u30e1\u30a4\u30e9\u30b9\u30c8,\u30a2\u30cb\u30e1 ver,\u30a2\u30cb\u30e1ver,\u30a2\u30cb\u30e1\u30a4\u30c8\u76e4,anime edition,anime version,anime cover,anime jacket,anime ver,\u671f\u9593\u751f\u7523\u9650\u5b9a\u76e4
# Max number of candidate releases whose cover will be queried (1-20)
cover.animeEditionMaxCandidates=5

# User Agent (MUST modify to your email)
# Format: ApplicationName/Version ( contact@email.com )
musicbrainz.userAgent=MusicDemo/1.0 ( your-email@example.com )

# ========================================
# AcoustID API Configuration
# ========================================

# AcoustID API Key (REQUIRED!)
# Register at https://acoustid.org/new-application
# Steps:
#   1. Visit the URL above
#   2. Fill in application name and email
#   3. Get API Key and fill it below
acoustid.apiKey=YOUR_API_KEY_HERE

# AcoustID API URL (usually no need to modify)
acoustid.apiUrl=https://api.acoustid.org/v2/lookup

# ========================================
# File Processing Configuration
# ========================================

# Auto-rename files based on metadata
# true: Rename to "Artist - Title.extension"
# false: Keep original filename
file.autoRename=true

# Create backup files (deprecated, now using copy mode)
# The program will copy processed files to output directory, keeping originals unchanged
file.createBackup=false

# ========================================
# Logging Configuration
# ========================================

# Enable detailed logging
# true: Output detailed processing information
# false: Output only critical information
logging.detailed=true

# Processed files log path (to prevent duplicate processing)
# Docker environment: Use container path /app/logs/processed_files.log
# Windows local: Use absolute path, e.g., D:/MusicTest/processed_files.log
# Or use default location: .musicdemo/processed_files.log in user home directory
logging.processedFileLogPath=/app/logs/processed_files.log

# ========================================
# Failed Files Handling Configuration
# ========================================

# Failed files storage directory
# When file identification fails and retries are exhausted, files will be moved here
# Docker environment: Use container path /app/failed_files
# Windows local: Use absolute path, e.g., D:/MusicTest/FailedFiles
# Leave empty to not move failed files
file.failedDirectory=/app/failed_files

# Partial recognition files storage directory
# When fingerprint recognition fails but the file has some tags (artist, album, composer, etc.) or cover art,
# files will be copied here in addition to the failed directory for user convenience
# Docker environment: Use container path /app/partial_files
# Windows local: Use absolute path, e.g., D:/MusicTest/PartialFiles
# Leave empty to not copy partial recognition files
file.partialDirectory=/app/partial_files

# Partial recognition admission gate (Phase 8 #23/#24)
# A cover alone is NOT enough: "cover.jpg + Track 01 / Unknown Artist" torrents
# are very common, and once they land in partialDirectory Plex shows a pile of
# "Unknown Artist" entries - polluting the library instead of helping.
# With this on, a folder/file must have a cover AND readable tags:
#   - >= coverage of files have a non-placeholder album
#   - >= coverage of files have a track number (or a numeric filename prefix)
#   - >= coverage of files have a non-placeholder artist
# Set to false to restore the old "cover only" behaviour.
file.partial.requireReadableTags=true
file.partial.minTagCoverage=0.8

# Maximum retry count (for network errors)
# Default: 3
file.maxRetries=3

# ========================================
# Audio Normalize Configuration
# ========================================

# Normalize high-res audio (>24-bit or >48kHz) to 24-bit/48kHz before fingerprinting and saving
audio.normalize.enabled=false

# ffmpeg binary path (must be available in PATH or set full path)
audio.normalize.ffmpegPath=ffmpeg

# ========================================
# CUE Split Configuration
# ========================================

# Enable cue split for album images (cue + single large audio file)
cue.split.enabled=false

# Output directory for cue split files (separate from monitor directory)
# Docker environment: Use container path /app/split_output
# Windows local: Use absolute path, e.g., D:/MusicTest/SplitOutput
cue.split.outputDir=/app/split_output

# ========================================
# Cover Art Cache Configuration
# ========================================

# Cover art cache directory
# Used to store downloaded and compressed cover images, avoiding duplicate downloads
# Docker environment: Use container path /app/.cover_cache
# Windows local: Use absolute path, e.g., D:/MusicTest/CoverCache
cache.coverArtDirectory=/app/.cover_cache

# ========================================
# Database Configuration
# ========================================

# Database type: file (text file) or mysql (MySQL database)
# Recommended to use mysql for better performance and reliability
db.type=file

# ===== MySQL Database Configuration =====
# If db.type=mysql, configure the following items

# MySQL server address
# Docker environment: Use host IP or container name
# Windows local: Use localhost or 127.0.0.1
# QNAP environment: Use QNAP IP address, e.g., 192.168.1.100
db.mysql.host=localhost

# MySQL port (default 3306)
db.mysql.port=3306

# Database name
# Please create this database in MySQL first:
# CREATE DATABASE music_demo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
db.mysql.database=music_demo

# MySQL username
db.mysql.username=root

# MySQL password (modify to your actual password)
db.mysql.password=YOUR_MYSQL_PASSWORD

# Connection pool configuration (usually no need to modify)
db.mysql.pool.maxPoolSize=10
db.mysql.pool.minIdle=2
db.mysql.pool.connectionTimeout=30000

# ========================================
# HTTP Proxy Configuration (Optional)
# ========================================

# Enable HTTP proxy
# Set to true if you need to access MusicBrainz and AcoustID API through proxy
proxy.enabled=false

# Proxy server address
# e.g., 127.0.0.1 or proxy.example.com
proxy.host=127.0.0.1

# Proxy server port
# e.g., 7890 (Clash), 1080 (V2Ray)
proxy.port=7890

# Proxy username (if proxy requires authentication)
proxy.username=

# Proxy password (if proxy requires authentication)
proxy.password=

# ========================================
# Internationalization Configuration
# ========================================

# Language setting: zh_CN (Simplified Chinese) or en_US (English)
# Controls the display language of Web dashboard and log output
# Default: zh_CN
# Available options:
#   - zh_CN: Simplified Chinese
#   - en_US: English
i18n.language=en_US

# ========================================
# Lyrics Configuration
# ========================================

# Export lyrics as separate .lrc file
# true: In addition to embedding in audio tags, also create a .lrc file with the same name in the same folder (for Plex and other media servers)
# false: Only embed lyrics in audio tags
# Default: false
lyrics.exportToFile=false

# ========================================
# Release Country Priority Configuration
# 专辑发行地区优先级配置
# ========================================

# Set the priority of album release countries, separated by commas
# 设置专辑发行地区的优先级，用逗号分隔
#
# The system will prefer album versions released in countries listed earlier
# 系统会优先选择排在前面的地区发行的专辑版本
#
# Note: This only affects version selection within the same album,
#       it will NOT affect album matching accuracy
# 注意：此配置仅影响同一专辑内的版本选择，不会影响专辑匹配的准确性
#
# Common country codes / 常用地区代码：
#   - JP: Japan / 日本
#   - US: United States / 美国
#   - GB: United Kingdom / 英国
#   - XW: Worldwide / 全球发行
#   - XE: Europe / 欧洲
#   - DE: Germany / 德国
#   - KR: South Korea / 韩国
#   - CN: China / 中国
#   - TW: Taiwan / 台湾
#   - HK: Hong Kong / 香港
#
# Leave empty to disable country priority (use default matching logic)
# 留空则不按地区筛选，使用默认的匹配逻辑
#
# Example / 示例: release.countryPriority=JP,US,GB,XW
release.countryPriority=

# ========================================
# Configuration Examples
# ========================================

# === QNAP Docker Environment Example ===
# monitor.directory=/music
# monitor.outputDirectory=/app/tagged_music
# logging.processedFileLogPath=/app/logs/processed_files.log
# cache.coverArtDirectory=/app/.cover_cache
# db.mysql.host=192.168.1.100
# db.mysql.password=your_qnap_mysql_password
# i18n.language=en_US

# === Windows Local Development Environment Example ===
# monitor.directory=D:/MusicTest/Download
# monitor.outputDirectory=D:/MusicTest/Music
# logging.processedFileLogPath=D:/MusicTest/processed_files.log
# cache.coverArtDirectory=D:/MusicTest/CoverCache
# db.mysql.host=localhost
# db.mysql.password=your_local_mysql_password
# i18n.language=en_US

# ========================================
# Important Notes
# ========================================
#
# 1. Required configuration items:
#    - monitor.directory
#    - monitor.outputDirectory
#    - acoustid.apiKey (get from https://acoustid.org)
#    - musicbrainz.userAgent (fill in your email)
#    - db.mysql.* (if using MySQL)
#
# 2. Path format:
#    - Windows: Use forward slash / or double backslash \\
#    - Correct: D:/Music or D:\\Music
#    - Wrong: D:\Music
#
# 3. Database setup:
#    - First-time use requires creating database and table structure
#    - Execute SQL statements in src/main/resources/schema.sql
#    - Or refer to DATABASE_SETUP.md documentation
#
# 4. Proxy settings:
#    - Recommended to enable proxy if using in mainland China
#    - Ensure proxy server can access international network
#
# 5. Performance optimization:
#    - Adjust monitor.scanInterval based on NAS performance
#    - If memory is limited, adjust JAVA_OPTS in docker-compose.yml
#
# 6. Language settings:
#    - Set i18n.language to zh_CN for Chinese interface
#    - Set i18n.language to en_US for English interface
#    - Restart application after changing language
#
# ========================================

# ========================================
# LLM Artist Matching Configuration (Optional)
# ========================================

# Enable LLM intelligent matching (only for partial recognition)
# When files enter partial recognition directory, use LLM to match artist names
# Supports romanization, aliases, etc. Auto-moves to output directory on success
llm.matching.enabled=false

# LLM API Keys (supports multiple, comma-separated, retry in order)
# Example: key1,key2,key3
llm.apiKey=

# LLM API URLs (supports multiple, comma-separated)
# Example: https://api.anthropic.com/v1/messages,https://api.openai.com/v1/chat/completions
llm.apiUrl=https://api.anthropic.com/v1/messages

# LLM Model Names (supports multiple, comma-separated)
# Example: claude-3-5-sonnet-20241022,gpt-4
llm.model=claude-3-5-sonnet-20241022

# ---- Generic LLM call settings (Phase 7 #21) ----
# Wire protocol: auto | anthropic | openai
# auto = guess from the URL (/v1/messages or *anthropic* -> anthropic, otherwise
# OpenAI-compatible). Set explicitly if your endpoint uses an unusual URL.
llm.provider=auto

# Max output tokens. Judgement tasks must be able to output a short reason,
# so the old hard-coded 100 was too small.
llm.maxTokens=600

# Temperature. Keep 0 for reproducible decisions.
llm.temperature=0.0

# Per-request timeout (seconds)
llm.timeoutSeconds=60

# Retries with exponential backoff for 429 / 5xx / network errors.
# After the retries are exhausted the next configured endpoint is tried.
llm.maxRetries=2

# ---- LLM album judgement (Phase 7 #22) ----
# Adds a "Let the LLM decide" button to the manual review panel.
# It is a CLOSED multiple-choice question: the model may only pick one of the
# candidate releases or answer "none of them". It is never asked "what album is
# this?", because an open question makes it invent album titles, years and
# track numbers - a bug much harder to notice than the current one.
llm.album.judge.enabled=false

# Whether an LLM conclusion may be written to disk without human confirmation.
# Default false: the conclusion is only a suggestion shown in the panel.
llm.album.autoApply=false
llm.album.autoApplyMinConfidence=0.85

# Native web search participation flags, matched by index with llm.apiKey/apiUrl/model.
# Only endpoints explicitly set to true are used by online assisted identification.
# OpenAI endpoints must support Responses API web_search; Anthropic endpoints must support Web Search Tool.
llm.webSearchEnabled=false

# Web search output budget. Deliberately separate from llm.maxTokens: search returns up to
# 5 candidates each with a full tracklist and source URLs, and 600 tokens truncates the JSON.
# Range 256..32000
llm.webSearch.maxTokens=4000
# Web search timeout in seconds. Search itself takes tens of seconds and may run two rounds.
# Range 30..900
llm.webSearch.timeoutSeconds=180

# ----------------------------------------
# Web search backend: native | tavily
# ----------------------------------------
# native  = the model's own web search tool (OpenAI Responses web_search / Anthropic Web Search Tool).
#           Most third-party OpenAI-compatible endpoints do NOT implement it, and even when the call
#           succeeds you cannot tell whether the model really searched. Citations are self-reported.
# tavily  = Tavily retrieves real pages, then any plain chat endpoint summarizes them.
#           Works with every OpenAI-compatible endpoint and every source URL provably exists,
#           so the HIGH/MEDIUM source threshold actually means something.
llm.webSearch.provider=native

# Tavily API key, get one at https://app.tavily.com. Required when provider=tavily.
tavily.apiKey=
tavily.apiUrl=https://api.tavily.com/search
# basic is cheaper with short excerpts; advanced digs deeper and suits niche / non-English releases.
tavily.searchDepth=advanced
# Results per query, range 1..20. Up to 4 queries are generated per album.
tavily.maxResults=8
# Range 5..300
tavily.timeoutSeconds=60
# Restrict retrieval to these domains. Leave EMPTY for whole-web search
# (expect far more LOW reliability sources, which cannot form a formal candidate on their own).
tavily.includeDomains=musicbrainz.org,discogs.com,vgmdb.net,spotify.com,music.apple.com,bandcamp.com,wikipedia.org,amazon.com,amazon.co.jp,last.fm,allmusic.com,rateyourmusic.com

# Recovery atomic workspace. Empty defaults to {outputDirectory}/.recovery-work
recovery.workDirectory=
# Recovery trash directory and retention: 0=delete immediately, -1=keep forever, 1..365 days
recovery.trashDirectory=data/recovery-trash
recovery.trash.retentionDays=7

# ========================================
# Manual Review Queue (Phase 6)
# ========================================

# Enable the "pending manual review" pipeline.
# When a folder's tracks are recognized but the album cannot be determined
# (typically a compilation not yet in MusicBrainz), files are NOT tagged/moved.
# Instead the folder is queued and waits for a decision in the web panel
# (/review.html). Disabled by default: with it off, such folders are archived
# immediately using synthesized album info (previous behaviour).
review.enabled=false

# Persisted review queue (JSON). Must survive restarts.
review.queuePath=data/review-queue.json

# Staging directory for transcoded temp files of queued folders.
# Long-pending items must not keep occupying the system temp directory.
review.stagingDirectory=data/review-staging
